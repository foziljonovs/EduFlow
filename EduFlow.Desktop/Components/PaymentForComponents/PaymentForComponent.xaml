<UserControl x:Class="EduFlow.Desktop.Components.PaymentForComponents.PaymentForComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EduFlow.Desktop.Components.PaymentForComponents"
             mc:Ignorable="d" 
             Height="45">
    <Border BorderThickness="1"
            BorderBrush="Gray"
            CornerRadius="5"
            Margin="3 5 3 0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="tbNumber"
                       Text="1"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="tbStudentName"
                       Grid.Column="1"
                       Text="Palonchi Pistonchiyev"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="tbAmount"
                       Grid.Column="2"
                       Text="0"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="tbDiscount"
                       Grid.Column="3"
                       Text="0"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border x:Name="PendingBorder"
                        CornerRadius="8"
                        Height="30"
                        Width="90"
                        Visibility="Collapsed"
                        Background="Gold">
                    <TextBlock Text="Kutilmoqda"
                               FontSize="14"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               Foreground="#14213d"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="CompletedBorder"
                        CornerRadius="8"
                        Height="30"
                        Width="90"
                        Visibility="Collapsed"
                        Background="MediumSeaGreen">
                    <TextBlock Text="Yakunlangan"
                               FontSize="14"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="FailedBorder"
                        CornerRadius="8"
                        Height="30"
                        Width="90"
                        Background="Tomato"
                        Visibility="Collapsed">
                    <TextBlock Text="Xato"
                               FontSize="14"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="RefundedBorder"
                        CornerRadius="8"
                        Height="30"
                        Width="90"
                        Background="#fca311"
                        Visibility="Collapsed">
                    <TextBlock Text="Qaytarilgan"
                               FontSize="14"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <TextBlock x:Name="tbType"
                       Grid.Column="5"
                       Text="Naqt"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="tbPaymentDate"
                       Grid.Column="6"
                       Text="16.06.2025 14:00"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>

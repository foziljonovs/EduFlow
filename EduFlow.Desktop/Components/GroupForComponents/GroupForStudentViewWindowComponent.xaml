<UserControl x:Class="EduFlow.Desktop.Components.GroupForComponents.GroupForStudentViewWindowComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EduFlow.Desktop.Components.GroupForComponents"
             mc:Ignorable="d" 
             Height="45">
    <Border Margin="0 5 5 0"
            CornerRadius="5"
            BorderThickness="1"
            BorderBrush="Gray">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0"
                       x:Name="tbName"
                       Text="Foundation"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="10 0"/>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border x:Name="ActiveBorder"
                        CornerRadius="8"
                        Height="30"
                        Width="70"
                        Visibility="Collapsed"
                        Background="MediumSeaGreen">
                    <TextBlock Text="Faol"
                               FontSize="14"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="ArchivedBorder"
                        CornerRadius="8"
                        Height="30"
                        Width="70"
                        Visibility="Collapsed"
                        Background="Gold">
                    <TextBlock Text="Saqlangan"
                               FontSize="14"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="GratuatedBorder"
                        CornerRadius="8"
                        Height="30"
                        Width="70"
                        Visibility="Collapsed"
                        Background="MediumSeaGreen">
                    <TextBlock Text="Bitirgan"
                               FontSize="14"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="DeletedBorder"
                        CornerRadius="8"
                        Height="30"
                        Width="70"
                        Background="Tomato"
                        Visibility="Collapsed">
                    <TextBlock Text="O'chirilgan"
                               FontSize="14"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

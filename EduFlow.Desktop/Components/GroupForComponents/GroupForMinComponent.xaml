<UserControl x:Class="EduFlow.Desktop.Components.GroupForComponents.GroupForMinComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EduFlow.Desktop.Components.GroupForComponents"
             mc:Ignorable="d" 
             Height="45">
    <Border CornerRadius="5"
            Margin="3 5 3 0"
            BorderThickness="1"
            BorderBrush="Gray"
            ToolTip="Guruh malumotlari">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="tbNumber"
                       Text="1"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       x:Name="tbName"
                       Text="Foundation 02.05.2025"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="2"
                          x:Name="tbStudentCount"
                          Text="15"
                          FontSize="16"
                          FontFamily="Jetbrains Mono"
                          FontWeight="SemiBold"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>

            <StackPanel Grid.Column="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border x:Name="ActiveBorder"
                        CornerRadius="8"
                        Height="30"
                        Width="90"
                        Visibility="Collapsed"
                        Background="MediumSeaGreen">
                    <TextBlock Text="Faol"
                               FontSize="14"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="ArchivedBorder"
                        CornerRadius="8"
                        Height="30"
                        Width="90"
                        Visibility="Collapsed"
                        Background="Gold">
                    <TextBlock Text="Saqlangan"
                               FontSize="14"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="GratuatedBorder"
                        CornerRadius="8"
                        Height="30"
                        Width="90"
                        Visibility="Collapsed"
                        Background="MediumSeaGreen">
                    <TextBlock Text="Bitirgan"
                               FontSize="14"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="DeletedBorder"
                        CornerRadius="8"
                        Height="30"
                        Width="90"
                        Background="Tomato"
                        Visibility="Collapsed">
                    <TextBlock Text="O'chirilgan"
                               FontSize="14"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

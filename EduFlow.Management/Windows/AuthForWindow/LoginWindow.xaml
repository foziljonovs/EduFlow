<Window x:Class="EduFlow.Management.Windows.AuthForWindow.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:EduFlow.Management.Windows.AuthForWindow" xmlns:local1="clr-namespace:EduFlow.Management.Components.Loader"
        mc:Ignorable="d"
        Title="LoginWindow"
        Height="450" 
        Width="400"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <RadioButton Grid.Row="0"
                     Style="{DynamicResource StateButton}"
                     Tag="close"
                     HorizontalAlignment="Right"
                     Click="RadioButton_Click"/>

        <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        Margin="20 0">
            <TextBlock Text="Tizimga kirish"
                           FontSize="26"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 20"
                           FontWeight="SemiBold"
                           FontFamily="Jetbrains Mono"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0.5*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                                VerticalAlignment="Center">
                    <TextBox x:Name="PhoneNumberTxt"
                                 Style="{DynamicResource PhoneNumberTextBoxStyle}"
                                 MaxLength="13"
                                 Text="+998"
                                 FontWeight="SemiBold"
                                 materialDesign:HintAssist.IsFloating="true"/>

                    <PasswordBox x:Name="PasswordPwd"
                                     Style="{DynamicResource PasswordTextBoxStyle}"
                                     FontWeight="SemiBold"
                                     MaxLength="8"
                                     materialDesign:HintAssist.IsFloating="True"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                                Margin="0 10">
                    <Button x:Name="LoginBtn"
                            Height="50"
                            Style="{DynamicResource MainButtonTwo}"
                            Click="LoginBtn_Click"/>

                    <local1:Loader x:Name="LoginLoader"
                                       Visibility="Collapsed"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="Edu Flow Management v1.0.2 | Yaratuvchi tyno.uz"
                   FontSize="14"
                   FontFamily="Jetbrains Mono"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
    </Grid>
</Window>

<Window x:Class="EduFlow.Management.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EduFlow.Management"
        mc:Ignorable="d"
        Title="MainWindow" 
        Height="600" 
        Width="1024"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal">
    <Grid Background="#ffffff">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0"
              Background="#14213d">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        VerticalAlignment="Center">
                <TextBlock Text="EduFlow"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#ffffff"
                           FontSize="28"
                           FontFamily="Jetbrains Mono"
                           FontWeight="Bold"/>

                <TextBlock Text="Management"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#ffffff"
                           FontSize="18"
                           FontFamily="Jetbrains Mono"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Margin="5">
                <RadioButton x:Name="HomeBtn"
                             Style="{DynamicResource MainButton}"
                             Tag="Home"
                             ToolTip="Asosiy sahifa"/>

                <RadioButton x:Name="SubscriptionBtn"
                             Style="{DynamicResource SubscriptionButton}"
                             Tag="Subscription"
                             ToolTip="Obunalar sahifasi"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="10 0"
                        HorizontalAlignment="Right"
                        Width="90"
                        Orientation="Horizontal">
                <RadioButton x:Name="MinButton"
                             Style="{DynamicResource StateButton}"
                             Tag="ChevronDown"
                             ToolTip="Yashirish"/>

                <StackPanel VerticalAlignment="Center">
                    <RadioButton x:Name="NormalButton"
                                 Style="{DynamicResource StateButton}"
                                 Tag="ArrowCollapse"
                                 ToolTip="Oddiy holat"
                                 Visibility="Collapsed"/>

                    <RadioButton x:Name="MaxButton"
                                 Style="{DynamicResource StateButton}"
                                 Tag="ArrowExpand"
                                 ToolTip="Kattalashtirish"/>
                </StackPanel>

                <RadioButton x:Name="CloseBtn"
                             Style="{DynamicResource StateButton}"
                             Tag="Close"
                             ToolTip="Yopish"/>
            </StackPanel>

            <StackPanel Grid.Row="1"
                  Margin="5"
                        Orientation="Horizontal">
                <Border Background="#e5e5e5"
                        Margin="5 0 10 0"
                        CornerRadius="8"
                        Width="200">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="tbActiveSubscriptionCount"
                                   FontSize="32"
                                   FontFamily="Jetbrains Mono"
                                   FontWeight="Bold"
                                   Foreground="#14213d"
                                   Text="100"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Faol obunalar"
                                   FontSize="14"
                                   FontFamily="Jetbrains Mono"
                                   FontWeight="SemiBold"
                                   Foreground="#14213d"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#e5e5e5"
                        Margin="5 0 10 0"
                        CornerRadius="8"
                        Width="200">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="tbNoActiveSubscription"
                                   FontSize="32"
                                   FontFamily="Jetbrains Mono"
                                   FontWeight="Bold"
                                   Foreground="#14213d"
                                   Text="100"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Yakunlangan obunalar"
                                   FontSize="14"
                                   FontFamily="Jetbrains Mono"
                                   FontWeight="SemiBold"
                                   Foreground="#14213d"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="#e5e5e5"
                        Margin="5 0 10 0"
                        CornerRadius="8"
                        Width="200">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="tbCompanyCount"
                                   FontSize="32"
                                   FontFamily="Jetbrains Mono"
                                   FontWeight="Bold"
                                   Foreground="#14213d"
                                   Text="100"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Hamkor o'quv markazlar"
                                   FontSize="14"
                                   FontFamily="Jetbrains Mono"
                                   FontWeight="SemiBold"
                                   Foreground="#14213d"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2"
                  Margin="5">
                <Frame x:Name="Navigate"
                       NavigationUIVisibility="Hidden"/>
            </Grid>
        </Grid>
    </Grid>
</Window>

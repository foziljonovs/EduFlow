<Window x:Class="EduFlow.Management.Windows.CompanyForWindows.ViewForCompanyEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EduFlow.Management.Windows.CompanyForWindows" xmlns:local1="clr-namespace:EduFlow.Management.Components.Loader"
        mc:Ignorable="d"
        Title="ViewForCompanyEmployeeWindow" 
        Height="500"
        Width="600"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Boshqaruvchilarni ko'rish"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="10 0"/>

            <RadioButton x:Name="CloseButton"
                         Style="{DynamicResource StateButton}"
                         Tag="close"
                         HorizontalAlignment="Right"
                         Click="CloseButton_Click"/>
        </Grid>

        <Grid Grid.Row="1"
              Margin="11 0 21 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="No"
                       FontFamily="Jetbrains Mono"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Text="Ism"
                       FontFamily="Jetbrains Mono"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="2"
                       Text="Telefon raqam"
                       FontFamily="Jetbrains Mono"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="3"
                       Text="Lavozim"
                       FontFamily="Jetbrains Mono"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="4"
                    x:Name="AddAdminButton"
                    Style="{DynamicResource CrudButton}"
                    Tag="add"
                    Background="MediumSeaGreen"/>
        </Grid>

        <Grid Grid.Row="2">
            <local1:Loader x:Name="AdminLoader"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>

            <ScrollViewer>
                <StackPanel x:Name="stAdmins"
                            Margin="5"/>
            </ScrollViewer>

            <TextBlock x:Name="emptyDataForAdmin"
                       Text="Boshqaruvchilar topilmadi!"
                       FontSize="14"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>

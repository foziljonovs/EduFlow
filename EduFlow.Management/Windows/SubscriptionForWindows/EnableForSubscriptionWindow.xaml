<Window x:Class="EduFlow.Management.Windows.SubscriptionForWindows.EnableForSubscriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EduFlow.Management.Windows.SubscriptionForWindows"
        mc:Ignorable="d"
        Title="EnableForSubscriptionWindow"
        Height="200"
        Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Obunani yoqish"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="10 0"/>

            <RadioButton x:Name="CloseButton"
                         Style="{DynamicResource StateButton}"
                         Tag="close"
                         HorizontalAlignment="Right"
                         ToolTip="Chiqish"
                         Click="CloseButton_Click"/>
        </Grid>

        <StackPanel Grid.Row="1"
                    Margin="10 5"
                    VerticalAlignment="Center">
            <ComboBox x:Name="SubscriptionTypeComboBox"
                      FontSize="16"
                      FontFamily="Jetbrains Mono"
                      FontWeight="SemiBold"
                      Margin="0 5 0 10"
                      VerticalContentAlignment="Center">
                <ComboBoxItem Content="Obunani tanlang" IsSelected="True" IsEnabled="False"/>
                <ComboBoxItem Content="Bir oylik" Tag="0"/>
                <ComboBoxItem Content="Bir martalik" Tag="1"/>
            </ComboBox>

            <StackPanel Orientation="Horizontal"
                        Margin="0 5 0 10"
                        HorizontalAlignment="Center">
                <CheckBox x:Name="IsPaidCheckBox"
                          Content="To'landimi?"
                          FontFamily="Jetbrains Mono"
                          FontWeight="SemiBold"
                          Foreground="Gray"
                          Margin="10 0"/>

                <CheckBox x:Name="IsActiveCheckBox"
                          Content="Faollashtirilsimi?"
                          FontFamily="Jetbrains Mono"
                          FontWeight="SemiBold"
                          Foreground="Gray"
                          Margin="10 0"/>
            </StackPanel>

            <Button x:Name="SaveButton"
                    Style="{DynamicResource saveButton}"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

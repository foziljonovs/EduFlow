<UserControl x:Class="EduFlow.Management.Components.UserForComponents.CompanyForUserComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EduFlow.Management.Components.UserForComponents"
             mc:Ignorable="d" 
             Height="40">
    <Border CornerRadius="5"
            BorderThickness="1"
            BorderBrush="Gray">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="tbName"
                       Text="Abdulvosid Foziljonov"
                       TextWrapping="Wrap"
                       FontSize="14"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       Margin="5"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       x:Name="tbPhoneNumber"
                       Text="+998900000000"
                       FontSize="14"
                       FontWeight="SemiBold"
                       FontFamily="Jetbrains Mono"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>

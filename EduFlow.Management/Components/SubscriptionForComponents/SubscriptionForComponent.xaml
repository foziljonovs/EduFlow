<UserControl x:Class="EduFlow.Management.Components.SubscriptionForComponents.SubscriptionForComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EduFlow.Management.Components.SubscriptionForComponents"
             mc:Ignorable="d" 
             Height="45">
    <Border CornerRadius="5"
            Margin="3 5 3 0"
            BorderThickness="1"
            BorderBrush="Gray">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="tbNumber"
                       Text="1"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       x:Name="tbCompanyName"
                       Text="Raqamli Texnalogiyalar Markazi"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border x:Name="TypeMonthlyBorder"
                        Height="25"
                        Width="80"
                        CornerRadius="8"
                        Background="#fca311"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock Text="Oylik"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="#14213d"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <Border x:Name="TypeYearBorder"
                        Height="25"
                        Width="80"
                        CornerRadius="8"
                        Background="#fca311"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock Text="Yillik"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="#14213d"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border x:Name="IsPaidBorder"
                        Height="25"
                        Width="120"
                        CornerRadius="8"
                        Background="MediumSeaGreen"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock Text="To'langan"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <Border x:Name="IsNoPaidBorder"
                        Height="25"
                        Width="100"
                        CornerRadius="8"
                        Background="Tomato"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock Text="To'lanmagan"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <TextBlock Grid.Column="4"
                       x:Name="tbSubscriptionDate"
                       Text="21.08.2025"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       FontSize="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border x:Name="IsActiveBorder"
                        Height="25"
                        Width="120"
                        CornerRadius="8"
                        Background="MediumSeaGreen"
                        Visibility="Collapsed">
                    <TextBlock Text="Faol"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <Border x:Name="IsNoActiveBorder"
                        Height="25"
                        Width="100"
                        CornerRadius="8"
                        Background="Tomato"
                        Visibility="Collapsed">
                    <TextBlock Text="Faol emas"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="6"
                        Orientation="Horizontal"
                        Margin="5 0">
                <Button x:Name="ViewButton"
                        Style="{DynamicResource CrudButton}"
                        Tag="Eye"
                        Background="DeepSkyBlue"
                        ToolTip="Ko'rish"/>

                <Button x:Name="EditButton"
                        Style="{DynamicResource CrudButton}"
                        Tag="Edit"
                        Background="Gold"
                        ToolTip="O'zgartirish"/>

                <Button x:Name="NoActiveButton"
                        Style="{DynamicResource CrudButton}"
                        Tag="Cancel"
                        Background="Tomato"
                        ToolTip="To'xtatish"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

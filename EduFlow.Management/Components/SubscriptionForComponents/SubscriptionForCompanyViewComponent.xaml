<UserControl x:Class="EduFlow.Management.Components.SubscriptionForComponents.SubscriptionForCompanyViewComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EduFlow.Management.Components.SubscriptionForComponents"
             mc:Ignorable="d" 
             Height="40">
    <Border CornerRadius="5"
            BorderThickness="1"
            BorderBrush="Gray">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border x:Name="ActiveBorder"
                        Margin="5"
                        CornerRadius="8"
                        Background="#fca311"
                        Visibility="Collapsed">
                    <TextBlock Text="Faol"
                               FontSize="16"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               Margin="5"
                               HorizontalAlignment="Center"
                               Foreground="White"/>
                </Border>

                <Border x:Name="NoActiveBorder"
                        Margin="5"
                        CornerRadius="8"
                        Background="Tomato"
                        Visibility="Collapsed">
                    <TextBlock Text="Faol emas"
                               FontSize="16"
                               FontFamily="Jetbrains Mono"
                               FontWeight="SemiBold"
                               Margin="5"
                               HorizontalAlignment="Center"
                               Foreground="White"/>
                </Border>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       x:Name="tbSubscriptionDate"
                       Text="10-08-2025"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       FontSize="14"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>

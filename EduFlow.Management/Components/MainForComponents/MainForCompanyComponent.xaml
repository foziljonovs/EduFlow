<UserControl x:Class="EduFlow.Management.Components.MainForComponents.MainForCompanyComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EduFlow.Management.Components.MainForComponents"
             mc:Ignorable="d" 
             Height="45">
    <Border CornerRadius="5"
            BorderThickness="1"
            BorderBrush="Gray"
            Margin="3 5 3 0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="tbNumber"
                       Text="1"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       x:Name="tbName"
                       Text="Raqamli Texnalogiyalar Markazi"
                       FontSize="16"
                       FontFamily="Jetbrainsn Mono"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="2"
                       x:Name="tbPhoneNumber"
                       Text="+998732542404"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border x:Name="activeBorder"
                        Height="25"
                        Width="80"
                        Background="MediumSeaGreen"
                        CornerRadius="8">
                    <TextBlock Text="Faol"
                               FontSize="16"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               FontFamily="Jetbrains Mono"/>
                </Border>

                <Border x:Name="noActiveBorder"
                        Height="25"
                        Visibility="Collapsed"
                        Width="80"
                        Background="Tomato"
                        CornerRadius="8">
                    <TextBlock Text="Faol emas"
                               FontSize="16"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               FontFamily="Jetbrains Mono"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="4"
                        Orientation="Horizontal"
                        Margin="5 0">
                <Button x:Name="ViewButton"
                        Style="{DynamicResource CrudButton}"
                        Tag="Eye"
                        Background="DeepSkyBlue"
                        ToolTip="Ko'rish"
                        Click="ViewButton_Click"/>

                <Button x:Name="EditButton"
                        Style="{DynamicResource CrudButton}"
                        Tag="Edit"
                        Background="Gold"
                        ToolTip="O'zgartirish"
                        Click="EditButton_Click"/>

                <Button x:Name="EditSubscriptionButton"
                        Style="{DynamicResource CrudButton}"
                        Tag="CreditCardRefreshOutline"
                        Background="MediumSeaGreen"
                        ToolTip="Obunani yangilash"
                        Click="EditSubscriptionButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

<Page x:Class="EduFlow.Management.Pages.SubscriptionForPages.SubscriptionForPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EduFlow.Management.Pages.SubscriptionForPages" xmlns:local1="clr-namespace:EduFlow.Management.Components.Loader"
      mc:Ignorable="d" 
      Title="SubscriptionForPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="No"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="ExtraBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Text="O'quv markaz"
                       FontSize="16"
                       FontWeight="ExtraBold"
                       FontFamily="Jetbrains Mono"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="2"
                       Text="Turi"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="ExtraBold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <TextBlock Grid.Column="3"
                       Text="To'lov"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="ExtraBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="4"
                       Text="Sana"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="ExtraBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="5"
                       Text="Holati"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="ExtraBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <local1:Loader x:Name="subscriptionLoader"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>

            <ScrollViewer>
                <StackPanel x:Name="stSubscriptions"/>
            </ScrollViewer>

            <TextBlock x:Name="emptyDataForSubscription"
                       Text="Obunalar topilmadi!"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>

<Page x:Class="EduFlow.Management.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EduFlow.Management.Pages" xmlns:local1="clr-namespace:EduFlow.Management.Components.Loader"
      mc:Ignorable="d" 
      Title="MainPage"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="3 0 21 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="No"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="ExtraBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Text="Nomi"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="ExtraBold"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="2"
                       Text="Telefon raqam"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="ExtraBold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <TextBlock Grid.Column="3"
                       Text="Obuna holati"
                       FontSize="16"
                       FontWeight="ExtraBold"
                       FontFamily="Jetbrains Mono"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="4"
                    x:Name="CreateCompanyButton"
                    Style="{DynamicResource CrudButton}"
                    Tag="add"
                    Background="MediumSeaGreen"
                    HorizontalAlignment="Right"
                    ToolTip="O'quv markaz ro'yxatga olish"/>
        </Grid>

        <Grid Grid.Row="1">
            <local1:Loader x:Name="companyLoader"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>

            <ScrollViewer>
                <StackPanel x:Name="stCompanies"/>
            </ScrollViewer>

            <TextBlock x:Name="emptyDataForCompany"
                       Text="O'quv markazlar topilmadi!"
                       FontSize="16"
                       FontFamily="Jetbrains Mono"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>
